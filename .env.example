# ---- Choose ONE provider ----

# Option A: OpenRouter (hosted, needs an API key, https://openrouter.ai/keys)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet


# Option B: LM Studio (local, free, no key needed) -- comment out Option A and uncomment below
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=qwen2.5-7b-instruct

# ---- Shared settings ----
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# Deterministic safety-net thresholds (see app/triage.py)
LOW_CONFIDENCE_THRESHOLD=0.55
KB_MATCH_SCORE_THRESHOLD=0.5
